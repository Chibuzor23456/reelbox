APP_ENV=local
APP_FRONTEND_ORIGIN=http://localhost:5173
APP_COOKIE_DOMAIN=
INVITATION_TTL_DAYS=7

# Outgoing mail — PHP's native mail(). On Hostinger this generally works
# out of the box once MAIL_FROM_ADDRESS is a real mailbox/alias on your
# domain (helps deliverability — avoid a from-address the domain can't send as).
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=ReelBox

DB_HOST=127.0.0.1
DB_NAME=reelbox
DB_USER=root
DB_PASS=

IPTV_PLAYLIST_URL=https://iptv-org.github.io/iptv/index.m3u
PLAYLIST_BATCH_SIZE=200
PLAYLIST_REFRESH_INTERVAL_HOURS=12
HEALTHCHECK_BATCH_SIZE=50

# VOD — Internet Archive movies adapter
IA_MOVIE_COLLECTIONS=feature_films
IA_ROWS_PER_COLLECTION=500

# VOD — Internet Archive series adapter (groups SxxExx-titled items)
IA_SERIES_SEASON_SCAN=6
IA_SERIES_ROWS_PER_SEASON=300

VOD_BATCH_SIZE=15
VOD_REFRESH_INTERVAL_HOURS=24

# Optional — poster/backdrop/synopsis/genre enrichment. Ingestion works
# without this, just with thinner metadata than the source itself provides.
TMDB_API_KEY=

# EPG — as of this writing, the only "live" server in IPTV-org's own
# GUIDES.md community list; it currently only covers 2 channels. Swap this
# for a real EPG provider's URL (XMLTV, gzip or plain) when you have one —
# nothing else about the ingestion pipeline needs to change.
EPG_SOURCE_URL=https://worker-9dd4.onrender.com/guide.xml.gz
EPG_BATCH_SIZE=500
EPG_REFRESH_INTERVAL_HOURS=6
