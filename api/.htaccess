RewriteEngine On

# A URL like /channels or /vod matches a real directory here — without this,
# Apache's mod_dir auto-redirects it to add a trailing slash before any PHP
# (and therefore apply_cors()) runs, so the redirect carries no CORS headers
# and browsers block it cross-origin even though curl doesn't care.
DirectorySlash Off

# Never serve dotfiles (.env, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Internal-only folders are never directly reachable over HTTP.
RewriteRule ^(config|lib|scripts|storage)(/|$) - [F,L]

# /auth/login -> /auth/login.php, etc. — lets endpoints be called without
# a .php extension.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]
