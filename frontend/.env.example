# Base URL of the PHP API — no /api suffix. The api/ folder IS the docroot
# of whatever serves it (locally, PHP's built-in server; in production, the
# api subdomain's PHP site on Hostinger), so endpoints live at the root:
# http://localhost:8000/auth/login, not http://localhost:8000/api/auth/login.
VITE_API_BASE_URL=http://localhost:8000
